{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install Python Dependencies",
      "type": "shell",
      "command": "source .venv/bin/activate && pip3 install -r ${workspaceFolder}/requirements.txt",
      "group": "build",
      "detail": "Installs Python packages from requirements.txt",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Clean Python Project",
      "type": "shell",
      "command": "source .venv/bin/activate && echo 'Cleaning up...' && rm -rf ${workspaceFolder}/.pytest_cache",
      "group": "none",
      "detail": "Removes test cache and other temporary files",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Format with Black",
      "type": "shell",
      "command": "source .venv/bin/activate && black ${workspaceFolder}/src",
      "group": "build",
      "detail": "Formats Python code in /src with Black",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}
